source "https://rubygems.org"

# GitHub Pages dependency lock — pulls in jekyll, kramdown,
# jekyll-feed, jekyll-seo-tag, and the rest of the GH Pages stack.
# Pin to a known version so local builds match CI; bump as needed.
# See https://pages.github.com/versions/ for the version GitHub Pages runs.
gem "github-pages", "~> 227", group: :jekyll_plugins

# Windows / JRuby tweaks (harmless on Linux/macOS).
gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin, :jruby]
gem "wdm", "~> 0.1.1", platforms: [:mingw, :x64_mingw, :mswin]
